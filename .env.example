# ==============================================================================
# Aanya Personal Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
ENVIRONMENT=development
DEBUG=false
APP_NAME="Aanya Assistant"
APP_VERSION="0.1.0"
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Secrets
# Generate a secure key for production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# CORS Configuration
# In production, restrict to your exact domain(s) e.g., ["https://aanya.yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:8000", "http://127.0.0.1", "http://127.0.0.1:8000"]

# Database Configuration (PostgreSQL)
# For Docker Compose: host is 'db', default port is 5432
POSTGRES_USER=aanya_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=aanya_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# For local dev without Docker, can be: postgresql+psycopg://aanya_user:replace_with_strong_db_password@localhost:5432/aanya_db
# Or for lightweight local testing: sqlite:///./aanya_dev.db
DATABASE_URL=postgresql+psycopg://aanya_user:replace_with_strong_db_password@db:5432/aanya_db

# Scheduler
SCHEDULER_AUTOSTART=true

# Caddy Deployment Domain (Used in Caddyfile for automatic HTTPS)
# Example: aanya.mydomain.com or :80 for local HTTP
DOMAIN_NAME=localhost
